---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { SECTIONS, sectionOf, type Section } from "@/data/sections";
import config from "@/config";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  const sorted = getSortedPosts(posts);

  return SECTIONS.map(section => ({
    params: { section: section.key },
    props: {
      section,
      posts: sorted.filter(post => sectionOf(post.id) === section.key),
    },
  }));
}) satisfies GetStaticPaths;

type Props = { section: Section; posts: Awaited<ReturnType<typeof getSortedPosts>> };

const { section, posts } = Astro.props;
---

<Layout
  title={`${section.label} | ${config.site.title}`}
  description={section.description}
>
  <Header />

  <Main pageTitle={section.label} pageDesc={section.description} class="mt-8">
    {
      posts.length === 0 ? (
        <p class="text-muted-foreground">아직 이 섹션에 쓴 글이 없습니다.</p>
      ) : (
        <ul>
          {posts.map(data => (
            <Card {...data} />
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>

---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SectionIndex from "@/components/SectionIndex.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import {
  SECTIONS,
  flattenSections,
  isUnderSection,
  sectionPathOf,
  type FlatSection,
} from "@/data/sections";
import config from "@/config";

export const getStaticPaths = (async () => {
  const sorted = getSortedPosts(await getCollection("posts"));

  return SECTIONS.map(section => {
    const path = section.key;
    const children = flattenSections(section.children ?? [], path).map(child => ({
      section: child,
      count: sorted.filter(post => sectionPathOf(post.id) === child.path).length,
    }));

    return {
      params: { section: path },
      props: {
        section: { ...section, path } as FlatSection,
        // 이 섹션에 바로 놓인 글만. 하위 섹션 글은 하위 페이지에서 보여준다.
        posts: sorted.filter(post => sectionPathOf(post.id) === path),
        children,
        total: sorted.filter(post => isUnderSection(post.id, path)).length,
      },
    };
  });
}) satisfies GetStaticPaths;

const { section, posts, children } = Astro.props;
---

<Layout
  title={`${section.label} | ${config.site.title}`}
  description={section.description}
>
  <Header />
  <SectionIndex {section} {posts} {children} />
  <Footer />
</Layout>

---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import CommentCount from "@/components/CommentCount.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import {
  SECTIONS,
  isUnderSection,
  sectionOf,
  sectionPathOf,
} from "@/data/sections";
import { commentTerm } from "@/data/comments";
import {
  profile,
  summary,
  experience,
  education,
  skills,
  certifications,
  featuredProjects,
  formatPeriod,
} from "@/data/resume";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = getSortedPosts(await getCollection("posts"));
const recentPosts = posts.slice(0, config.posts.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <!-- 프로필 -->
    <section class="app-layout-wide pt-12 pb-10 lg:pt-16">
      <p class="text-accent mb-2 text-sm font-medium tracking-wide">
        {profile.location}
      </p>
      <h1 class="text-3xl font-bold sm:text-4xl">{profile.name}</h1>
      <p class="text-muted-foreground mt-1 text-lg">{profile.role}</p>
      <p class="mt-5 max-w-2xl leading-relaxed whitespace-pre-line">
        {summary}
      </p>
      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a
          href={`mailto:${profile.email}`}
          class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          {profile.email}
        </a>
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          github.com/loading1031
        </a>
      </div>
    </section>

    <!-- 섹션 바로가기 -->
    <section class="app-layout-wide pb-12">
      <h2 class="section-heading">기록</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          SECTIONS.map(section => {
            const count = posts.filter(
              p =>
                sectionPathOf(p.id) === section.key ||
                isUnderSection(p.id, section.key)
            ).length;
            return (
              <a
                href={getRelativeLocaleUrl(locale, section.key)}
                class="border-border hover:border-accent hover:bg-surface group rounded-lg border p-4 transition-colors"
              >
                <div class="flex items-baseline justify-between">
                  <span class="group-hover:text-accent font-medium">
                    {section.label}
                  </span>
                  <span class="text-muted-foreground text-sm tabular-nums">
                    {count}
                  </span>
                </div>
                <p class="text-muted-foreground mt-1 text-sm">
                  {section.description}
                </p>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- 경력 -->
    {
      experience.length > 0 && (
        <section class="app-layout-wide pb-12">
          <h2 class="section-heading">경력</h2>
          <ol class="space-y-8">
            {experience.map(item => (
              <li class="border-border relative border-s ps-5">
                <span
                  aria-hidden="true"
                  class="bg-accent absolute -start-[4.5px] top-2 size-2 rounded-full"
                />
                <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                  <h3 class="font-semibold">{item.company}</h3>
                  <span class="text-muted-foreground font-code text-sm tabular-nums">
                    {formatPeriod(item.period)}
                  </span>
                </div>
                <p class="text-accent text-sm">{item.role}</p>
                {item.summary && (
                  <p class="text-muted-foreground mt-2 text-sm">
                    {item.summary}
                  </p>
                )}
                <ul class="mt-3 space-y-1.5 text-sm">
                  {item.highlights.map(highlight => (
                    <li class="before:text-muted-foreground relative ps-4 before:absolute before:start-0 before:content-['–']">
                      {highlight}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- 대표 프로젝트 -->
    {
      featuredProjects.length > 0 && (
        <section class="app-layout-wide pb-12">
          <h2 class="section-heading">대표 프로젝트</h2>
          <ul class="space-y-5">
            {featuredProjects.map(project => (
              <li>
                <div class="flex flex-wrap items-baseline gap-x-3">
                  <h3 class="font-semibold">
                    {project.url ? (
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
                      >
                        {project.name}
                      </a>
                    ) : (
                      project.name
                    )}
                  </h3>
                  <span class="text-muted-foreground font-code text-xs">
                    {project.stack.join(" · ")}
                  </span>
                </div>
                <p class="text-muted-foreground mt-1 text-sm">
                  {project.description}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- 기술 스택 -->
    {
      skills.length > 0 && (
        <section class="app-layout-wide pb-12">
          <h2 class="section-heading">기술 스택</h2>
          <dl class="space-y-3">
            {skills.map(group => (
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                <dt class="text-muted-foreground w-24 shrink-0 text-sm">
                  {group.category}
                </dt>
                <dd class="flex flex-wrap gap-2">
                  {group.items.map(item => (
                    <span class="bg-muted font-code rounded px-2 py-0.5 text-sm">
                      {item}
                    </span>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <!-- 학력 -->
    {
      education.length > 0 && (
        <section class="app-layout-wide pb-12">
          <h2 class="section-heading">학력</h2>
          <ul class="space-y-3">
            {education.map(item => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-3">
                <div>
                  <span class="font-medium">{item.school}</span>
                  <span class="text-muted-foreground ms-2 text-sm">
                    {item.degree}
                  </span>
                </div>
                <span class="text-muted-foreground font-code text-sm tabular-nums">
                  {formatPeriod(item.period)}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- 자격증 -->
    {
      certifications.length > 0 && (
        <section class="app-layout-wide pb-12">
          <h2 class="section-heading">자격증</h2>
          <ul class="space-y-2">
            {certifications.map(item => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-3">
                <div>
                  <span class="font-medium">{item.name}</span>
                  <span class="text-muted-foreground ms-2 text-sm">
                    {item.issuer}
                  </span>
                </div>
                <span class="text-muted-foreground font-code text-sm tabular-nums">
                  {item.date}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- 최근 글 -->
    {
      recentPosts.length > 0 && (
        <section class="app-layout-wide pb-12">
          <h2 class="section-heading">최근 글</h2>
          <ul class="space-y-5">
            {recentPosts.map(post => {
              const section = sectionOf(post.id);
              return (
                <li>
                  <div class="flex items-baseline gap-2">
                    {section && (
                      <span class="text-muted-foreground text-xs">
                        {section.label}
                      </span>
                    )}
                    <Datetime
                      pubDatetime={post.data.pubDatetime}
                      modDatetime={post.data.modDatetime}
                      timezone={post.data.timezone}
                    />
                    <CommentCount
                      term={commentTerm(
                        getPostUrl(post.id, post.filePath, locale)
                      )}
                    />
                  </div>
                  <a
                    href={getPostUrl(post.id, post.filePath, locale)}
                    class="text-accent font-medium decoration-dashed underline-offset-4 hover:underline"
                  >
                    {post.data.title}
                  </a>
                  <p class="text-muted-foreground mt-0.5 text-sm">
                    {post.data.description}
                  </p>
                </li>
              );
            })}
          </ul>
          <a
            href={getRelativeLocaleUrl(locale, "archives")}
            class="hover:text-accent mt-6 inline-flex items-center gap-1 text-sm"
          >
            글 전체 보기
            <IconArrowRight class="inline-block size-4" />
          </a>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

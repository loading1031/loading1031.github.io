---
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

type PostLink = {
  id: string;
  title: string;
  filePath: string | undefined;
};

type Props = {
  postLinks: PostLink[];
  currentIndex: number;
  sectionLabel: string;
};

const { postLinks, currentIndex, sectionLabel } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const pageSize = 10;
const lastStart = Math.max(0, postLinks.length - pageSize);
const initialStart = Math.min(
  lastStart,
  Math.max(0, currentIndex - Math.floor(pageSize / 2))
);
---

<nav
  data-post-list
  data-initial-start={initialStart}
  aria-label={`${sectionLabel} 글 목록`}
  class="my-8"
>
  <h2 class="mb-4 text-lg font-semibold">{sectionLabel} 글 목록</h2>
  <ol class="space-y-3">
    {
      postLinks.map((post, index) => (
        <li
          data-post-item
          hidden={index < initialStart || index >= initialStart + pageSize}
        >
          <a
            href={getPostUrl(post.id, post.filePath, locale)}
            aria-current={index === currentIndex ? "page" : undefined}
            class:list={[
              "hover:underline",
              index === currentIndex
                ? "text-foreground font-semibold"
                : "text-accent/85",
            ]}
          >
            {post.title}
            {index === currentIndex && (
              <span class="ml-2 text-sm">현재 글</span>
            )}
          </a>
        </li>
      ))
    }
  </ol>
  {
    postLinks.length > pageSize && (
      <div class="mt-5 flex items-center justify-center gap-4">
        <button
          type="button"
          data-post-newer
          disabled={initialStart === 0}
          class="cursor-pointer disabled:cursor-default disabled:opacity-40"
        >
          더 최근
        </button>
        <span data-post-status aria-live="polite">
          {initialStart + 1}–
          {Math.min(initialStart + pageSize, postLinks.length)} /{" "}
          {postLinks.length}
        </span>
        <button
          type="button"
          data-post-older
          disabled={initialStart === lastStart}
          class="cursor-pointer disabled:cursor-default disabled:opacity-40"
        >
          더 이전
        </button>
      </div>
    )
  }
</nav>

<script>
  function initPostLists() {
    document.querySelectorAll<HTMLElement>("[data-post-list]").forEach(root => {
      if (root.dataset.initialized) return;
      root.dataset.initialized = "true";

      const items = Array.from(
        root.querySelectorAll<HTMLElement>("[data-post-item]")
      );
      const newer = root.querySelector<HTMLButtonElement>("[data-post-newer]");
      const older = root.querySelector<HTMLButtonElement>("[data-post-older]");
      const status = root.querySelector<HTMLElement>("[data-post-status]");
      if (!newer || !older || !status) return;

      const pageSize = 10;
      const lastStart = Math.max(0, items.length - pageSize);
      let start = Number(root.dataset.initialStart);
      const show = (nextStart: number) => {
        start = nextStart;
        items.forEach((item, index) => {
          item.hidden = index < start || index >= start + pageSize;
        });
        newer.disabled = start === 0;
        older.disabled = start === lastStart;
        status.textContent = `${start + 1}–${Math.min(start + pageSize, items.length)} / ${items.length}`;
      };

      newer.addEventListener("click", () =>
        show(Math.max(0, start - pageSize))
      );
      older.addEventListener("click", () =>
        show(Math.min(lastStart, start + pageSize))
      );
    });
  }

  document.addEventListener("astro:page-load", initPostLists);
  initPostLists();
</script>

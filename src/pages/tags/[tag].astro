---
import type { GetStaticPaths } from 'astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE, TAG_LABELS } from '../../consts';
import { collectTags, getPublishedPosts } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
	const posts = await getPublishedPosts();
	return collectTags(posts).map(({ tag }) => ({
		params: { tag },
		props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
};

const { tag } = Astro.params;
const { posts } = Astro.props;
const label = TAG_LABELS[tag] ?? tag;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`#${label} | ${SITE_TITLE}`} description={`${label} 태그가 붙은 글 목록`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>#{label}</h1>
			<p class="count">{posts.length}개의 글</p>
			<PostList posts={posts} />
			<p><a href="/tags">← 태그 전체 보기</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.2em;
	}
	.count {
		margin-top: 0;
		color: rgb(var(--gray));
	}
</style>

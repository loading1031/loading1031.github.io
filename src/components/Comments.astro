---
/**
 * 글 하단 댓글 (giscus → GitHub Discussions).
 *
 * 스크립트를 마크업에 그냥 박지 않고 인라인 스크립트가 붙인다. 뷰 트랜지션으로
 * 이동하면 `<script src>` 는 다시 실행되지 않아 다음 글에서 댓글창이 안 뜬다.
 * `data-astro-rerun` 이 붙은 인라인 스크립트만 매 페이지 다시 돈다.
 *
 * ⚠️ 이 레포에 giscus 앱(https://github.com/apps/giscus)이 설치돼 있어야
 *    댓글창이 뜬다. Discussions 설정만으로는 부족하다.
 */
import { GISCUS } from "@/data/comments";

type Props = {
  /** `commentTerm()` 이 만든 글 경로. Discussion 제목이 된다. */
  term: string;
};

const { term } = Astro.props;
---

<section class="mt-8" aria-label="댓글">
  <h2 class="mb-4 text-lg font-semibold">댓글</h2>
  <div
    data-giscus
    data-repo={GISCUS.repo}
    data-repo-id={GISCUS.repoId}
    data-category={GISCUS.category}
    data-category-id={GISCUS.categoryId}
    data-term={term}
  >
  </div>
</section>

<script is:inline data-astro-rerun>
  (function initGiscus() {
    const host = document.querySelector("[data-giscus]");
    if (!host || host.childElementCount > 0) return;

    function giscusTheme() {
      return document.documentElement.getAttribute("data-theme") === "dark"
        ? "dark_dimmed"
        : "light";
    }

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    Object.assign(script.dataset, {
      repo: host.dataset.repo,
      repoId: host.dataset.repoId,
      category: host.dataset.category,
      categoryId: host.dataset.categoryId,
      mapping: "specific",
      term: host.dataset.term,
      strict: "1",
      reactionsEnabled: "1",
      emitMetadata: "0",
      inputPosition: "top",
      theme: giscusTheme(),
      lang: "ko",
      loading: "lazy",
    });
    host.appendChild(script);

    // 테마 토글에 맞춰 iframe 안쪽도 바꾼다. 다시 만들면 입력 중이던 댓글이 날아간다.
    if (!window.__giscusThemeBound) {
      window.__giscusThemeBound = true;
      new MutationObserver(() => {
        const frame = document.querySelector("iframe.giscus-frame");
        if (!frame) return;
        frame.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: giscusTheme() } } },
          "https://giscus.app"
        );
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }
  })();
</script>

---
/**
 * 글 하단 댓글 (giscus → GitHub Discussions).
 *
 * 스크립트를 마크업에 그냥 박지 않고 인라인 스크립트가 붙인다. 뷰 트랜지션으로
 * 이동하면 `<script src>` 는 다시 실행되지 않아 다음 글에서 댓글창이 안 뜬다.
 * `data-astro-rerun` 이 붙은 인라인 스크립트만 매 페이지 다시 돈다.
 *
 * ⚠️ `<div class="giscus" id="comments">` 의 **클래스와 id 는 둘 다 필수다.**
 *    giscus 스크립트는 `.giscus` 를 찾아 거기에 iframe 을 꽂는데, 그 요소에 id 가
 *    있으면 로그인 후 돌아올 주소에 `#<id>` 를 붙여 준다. 이게 없으면 GitHub 로그인을
 *    마치고 돌아왔을 때 페이지 맨 위로 떨어져서 댓글까지 다시 스크롤해야 한다.
 *    (앵커는 암호화된 OAuth state 에 실려 가므로 GitHub 을 거쳐도 살아 돌아온다.)
 *
 * ⚠️ 이 레포에 giscus 앱(https://github.com/apps/giscus)이 설치돼 있어야
 *    댓글창이 뜬다. Discussions 설정만으로는 부족하다.
 */
import { GISCUS } from "@/data/comments";

type Props = {
  /** `commentTerm()` 이 만든 글 경로. Discussion 제목이 된다. */
  term: string;
};

const { term } = Astro.props;
---

<section
  class="mt-8"
  aria-labelledby="comments-heading"
  data-giscus-host
  data-repo={GISCUS.repo}
  data-repo-id={GISCUS.repoId}
  data-category={GISCUS.category}
  data-category-id={GISCUS.categoryId}
  data-term={term}
>
  <h2 id="comments-heading" class="mb-4 text-lg font-semibold">댓글</h2>

  <!-- 로그인하고 돌아올 자리. min-height 는 iframe 이 뜨기 전 높이를 잡아 둬서
       앵커로 떨어졌을 때 위치가 덜 튀게 한다. -->
  <div class="giscus min-h-50" id="comments"></div>
</section>

<script is:inline data-astro-rerun>
  (function initGiscus() {
    const host = document.querySelector("[data-giscus-host]");
    const container = host && host.querySelector(".giscus");
    // 이미 붙었으면 다시 붙이지 않는다. 다시 만들면 쓰던 댓글이 날아간다.
    if (!container || container.querySelector("iframe")) return;

    // 로그인하고 돌아온 길인지. giscus 스크립트가 주소에서 이 값을 지우기 전에 봐 둔다.
    const cameBackFromLogin = new URLSearchParams(location.search).has(
      "giscus"
    );

    function giscusTheme() {
      return document.documentElement.getAttribute("data-theme") === "dark"
        ? "dark_dimmed"
        : "light";
    }

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    Object.assign(script.dataset, {
      repo: host.dataset.repo,
      repoId: host.dataset.repoId,
      category: host.dataset.category,
      categoryId: host.dataset.categoryId,
      mapping: "specific",
      term: host.dataset.term,
      strict: "1",
      reactionsEnabled: "1",
      emitMetadata: "0",
      inputPosition: "top",
      theme: giscusTheme(),
      lang: "ko",
      loading: "lazy",
    });
    host.appendChild(script);

    // 로그인하고 돌아왔으면 댓글 자리로 직접 내려간다.
    //
    // 주소에 붙은 #comments 는 믿을 수 없다. giscus 스크립트가 로드되면서 세션
    // 파라미터와 **해시를 같이 지우는데**, 그게 브라우저의 앵커 스크롤보다 먼저
    // 끝나면 스크롤이 아예 일어나지 않는다. 글이 길수록 레이아웃이 늦어져 giscus 가
    // 이긴다. 그리고 iframe 은 lazy 라 화면 근처로 가기 전에는 로드조차 되지 않아,
    // "댓글이 다 뜨면 그때 내려가자" 는 영원히 오지 않는다.
    if (cameBackFromLogin) {
      host.scrollIntoView({ block: "start", behavior: "instant" });

      // 위에서 자리로 왔으니 이제 lazy iframe 이 뜬다. 뜨면서 높이가 늘어나 위치가
      // 밀리므로 한 번 더 맞춘다. giscus 는 높이를 여러 번 알려주므로(0 → 84 → …)
      // 더 안 올 때까지 기다렸다가 맞춘다.
      let settle;
      const onResize = event => {
        if (event.origin !== "https://giscus.app") return;
        if (
          !event.data ||
          !event.data.giscus ||
          !event.data.giscus.resizeHeight
        )
          return;
        clearTimeout(settle);
        settle = setTimeout(() => {
          window.removeEventListener("message", onResize);
          host.scrollIntoView({ block: "start", behavior: "smooth" });
        }, 300);
      };
      window.addEventListener("message", onResize);
      // 댓글이 영영 안 뜨더라도 리스너를 붙들고 있지 않는다.
      setTimeout(() => window.removeEventListener("message", onResize), 15000);
    }

    // 테마 토글에 맞춰 iframe 안쪽도 바꾼다. 다시 만들면 입력 중이던 댓글이 날아간다.
    if (!window.__giscusThemeBound) {
      window.__giscusThemeBound = true;
      new MutationObserver(() => {
        const frame = document.querySelector("iframe.giscus-frame");
        if (!frame) return;
        frame.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: giscusTheme() } } },
          "https://giscus.app"
        );
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }
  })();
</script>

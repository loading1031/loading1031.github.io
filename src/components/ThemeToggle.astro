---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<button
  id="theme-btn"
  class="focus-outline hover:[&>svg]:stroke-accent text-muted-foreground relative size-9"
  title={t.a11y.toggleTheme}
  aria-label="auto"
  aria-live="polite"
>
  <IconMoon
    class="absolute top-1/2 left-1/2 size-5 translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
  />
  <IconSunHigh
    class="absolute top-1/2 left-1/2 size-5 translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
  />
</button>

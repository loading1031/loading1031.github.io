---
/**
 * 섹션(및 하위 섹션) 글 목록 본문.
 * /study/ 와 /study/database/ 가 같은 화면을 쓰므로 한 곳에 모아 둔다.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";
import Main from "./Main.astro";
import Card from "./Card.astro";
import type { FlatSection } from "@/data/sections";
import config from "@/config";

type Props = {
  section: FlatSection;
  posts: CollectionEntry<"posts">[];
  /** 하위 섹션과 그 글 개수 */
  children?: { section: FlatSection; count: number }[];
};

const { section, posts, children = [] } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<Main pageTitle={section.label} pageDesc={section.description} class="mt-8">
  {
    children.length > 0 && (
      <div class="mb-10 grid gap-3 sm:grid-cols-2">
        {children.map(({ section: child, count }) => (
          <a
            href={getRelativeLocaleUrl(locale, child.path)}
            class="border-border hover:border-accent hover:bg-surface group rounded-lg border p-4 transition-colors"
          >
            <div class="flex items-baseline justify-between">
              <span class="group-hover:text-accent font-medium">
                {child.label}
              </span>
              <span class="text-muted-foreground text-sm tabular-nums">
                {count}
              </span>
            </div>
            <p class="text-muted-foreground mt-1 text-sm">
              {child.description}
            </p>
          </a>
        ))}
      </div>
    )
  }

  {
    posts.length === 0 ? (
      <p class="text-muted-foreground">
        {children.length > 0
          ? "이 섹션에 바로 쓴 글은 아직 없습니다. 위 하위 섹션을 눌러보세요."
          : "아직 이 섹션에 쓴 글이 없습니다."}
      </p>
    ) : (
      <ul>
        {posts.map(data => (
          <Card {...data} />
        ))}
      </ul>
    )
  }
</Main>

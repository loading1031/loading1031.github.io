---
/**
 * 모바일 전용 상단 바. 데스크톱(lg 이상)에서는 사이드바가 그 역할을 하므로 숨긴다.
 * 사이드바 자체는 Layout.astro 가 렌더링한다.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import ThemeToggle from "./ThemeToggle.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="border-border bg-background/85 sticky top-0 z-20 border-b backdrop-blur-md lg:hidden"
>
  <div class="flex items-center justify-between px-4 py-3">
    <button
      id="sidebar-open"
      class="focus-outline -ms-2 p-2"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="sidebar"
    >
      <IconMenuDeep class="size-6" />
    </button>
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="focus-outline text-lg font-semibold">{site.title}</a
    >
    <div class="-me-2 flex items-center">
      {
        features.search !== false && (
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            class="focus-outline text-muted-foreground hover:text-accent p-2"
            aria-label={t.nav.search}
          >
            <IconSearch class="size-5" />
          </a>
        )
      }
      {features.lightAndDarkMode && <ThemeToggle />}
    </div>
  </div>
</header>

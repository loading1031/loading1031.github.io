---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
const privacyUrl = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "privacy"
);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div
      class="text-muted-foreground my-2 flex flex-col items-center text-sm whitespace-nowrap sm:flex-row"
    >
      <span>&#169; {currentYear} {config.site.author}</span>
      <span class="hidden sm:inline">&nbsp;·&nbsp;</span>
      <span>{config.site.title}</span>
      <span class="hidden sm:inline">&nbsp;·&nbsp;</span>
      <a
        href={privacyUrl}
        class="hover:text-accent underline-offset-4 hover:underline"
      >
        개인정보처리방침
      </a>
    </div>
  </div>
</footer>
